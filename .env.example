# Public Vite runtime configuration. Do not put passwords, OAuth client secrets,
# payment credentials, or private API keys in this file.
VITE_APP_NAME=Token Club
VITE_APP_DESCRIPTION=Личный кабинет
VITE_DEFAULT_LANGUAGE=ru
VITE_SHM_BASE_PATH=/

# Authentication
VITE_TELEGRAM_BOT_AUTH_ENABLE=false
VITE_TELEGRAM_OIDC_AUTH_ENABLE=false
VITE_TELEGRAM_WEBAPP_AUTH_ENABLE=false
VITE_TELEGRAM_WEBAPP_AUTO_AUTH_ENABLE=false
VITE_PASSKEY_ENABLE=true
VITE_PASSKEY_AUTH_DISABLED=false

# OAuth providers are enabled and configured by SHM API. The client uses:
# /shm/v1/oauth2/start/yandex, /google, /vk, /github

# Support and legal links
VITE_SUPPORT_LINK=
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_OF_USE_URL=
VITE_PUBLIC_OFFER_URL=
VITE_USER_AGREEMENT_URL=

# VPN/proxy connection data
VITE_PROXY_CATEGORY=proxy
VITE_PROXY_STORAGE_PREFIX=vpn_mrzb_
VITE_SHOW_PROXY_SUB_LINK=true
VITE_SHOW_PROXY_QR=true
VITE_SHOW_HAPP_CRYPTOLINK=false
VITE_VPN_CATEGORY=vpn
VITE_VPN_STORAGE_PREFIX=vpn

# Profile and services
VITE_EMAIL_REQUIRED=false
VITE_EMAIL_VERIFY_REQUIRED=false
VITE_ALLOW_EMAIL_VERIFY=false
VITE_ALLOW_SERVICE_BLOCKED=true
VITE_ALLOW_SERVICE_DELETE=true
VITE_ALLOW_SERVICE_CHANGE=true
