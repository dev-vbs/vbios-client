# Vite development/build configuration.
# All VITE_* values are embedded in the client bundle and therefore must be public.
# In Docker production use the matching unprefixed variables in the backend .env.

VITE_APP_NAME=VBIOS
VITE_APP_DESCRIPTION=Личный кабинет VPN
VITE_LOGO_URL=
VITE_DEFAULT_LANGUAGE=ru
VITE_SINGLE_LANGUAGE=ru
VITE_CUSTOM_LANGS=
VITE_SHM_BASE_PATH=/

# Authentication
VITE_OTP_ENABLE=true
VITE_PASSKEY_ENABLE=true
VITE_PASSKEY_AUTH_DISABLED=false
VITE_TELEGRAM_BOT_NAME=
VITE_TELEGRAM_BOT_AUTH_ENABLE=false
VITE_TELEGRAM_OIDC_AUTH_ENABLE=false
VITE_TELEGRAM_BOT_AUTH_PROFILE=telegram_bot
VITE_TELEGRAM_WEBAPP_AUTH_ENABLE=false
VITE_TELEGRAM_WEBAPP_AUTO_AUTH_ENABLE=false
VITE_TELEGRAM_WEBAPP_PROFILE=

# Public support and legal links
VITE_SUPPORT_LINK=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_PRIVACY_POLICY_URL=
VITE_RETURN_POLICY_URL=
VITE_TERMS_OF_USE_URL=
VITE_PUBLIC_OFFER_URL=
VITE_USER_AGREEMENT_URL=
VITE_SUPPORT_WIDGET_URL=
VITE_SUPPORT_WIDGET_API=
VITE_BITRIX_WIDGET_SCRIPT_URL=

# Services
VITE_VPN_CATEGORY=vpn
VITE_VPN_CATEGORY_TITLE=VPN
VITE_VPN_STORAGE_PREFIX=vpn
VITE_PROXY_CATEGORY=vpn-mz,vpn-promo
VITE_PROXY_CATEGORY_TITLE=VPN Подписка
VITE_PROXY_STORAGE_PREFIX=vpn_mrzb_
VITE_VISIBLE_CATEGORIES=
VITE_SHOW_PROXY_SUB_LINK=true
VITE_SHOW_PROXY_QR=true
VITE_SHOW_HAPP_CRYPTOLINK=false
VITE_DEVICE_CONFIG_TEXT=

# Profile and order policy
VITE_EMAIL_REQUIRED=false
VITE_EMAIL_VERIFY_REQUIRED=false
VITE_ALLOW_EMAIL_VERIFY=false
VITE_ALLOW_SERVICE_BLOCKED=true
VITE_ALLOW_SERVICE_DELETE=true
VITE_ALLOW_SERVICE_CHANGE=true
VITE_ALLOW_SERVICE_CHANGE_FORCE=false
VITE_SERVICE_CHANGE_ALL_CATEGORY=true
VITE_BLOCK_ORDER_IF_UNPAID=false
VITE_ALLOW_TELEGRAM_PIN=false
VITE_ORDER_SORTING=cost_asc
VITE_ORDER_COST_DISCOUNT=true
VITE_ORDER_COST_WITH_BONUSES=false

# Download links. Use only public URLs.
VITE_VPN_APP_WINDOWS_URL=
VITE_VPN_APP_LINUX_URL=
VITE_VPN_APP_MAC_URL=
VITE_VPN_APP_IOS_URL=
VITE_VPN_APP_ANDROID_URL=
VITE_VPN_WINDOWS_APP_NAME=Happ
VITE_VPN_LINUX_APP_NAME=Happ
VITE_VPN_MAC_APP_NAME=Happ
VITE_VPN_IOS_APP_NAME=Happ
VITE_VPN_ANDROID_APP_NAME=Happ

VITE_PROXY_APP_WINDOWS_URL=
VITE_PROXY_APP_LINUX_URL=
VITE_PROXY_APP_MAC_URL=
VITE_PROXY_APP_IOS_URL=
VITE_PROXY_APP_ANDROID_URL=
VITE_PROXY_WINDOWS_APP_NAME=v2rayN
VITE_PROXY_LINUX_APP_NAME=v2rayA
VITE_PROXY_MAC_APP_NAME=V2RayU
VITE_PROXY_IOS_APP_NAME=Streisand
VITE_PROXY_ANDROID_APP_NAME=v2rayNG
VITE_APPLE_TV_APP_NAME=Streisand
VITE_ANDROID_TV_APP_NAME=v2rayNG
VITE_WINDOWS_PROXY_URL_SCHEMA=
VITE_LINUX_PROXY_URL_SCHEMA=
VITE_MAC_PROXY_URL_SCHEMA=
VITE_IOS_PROXY_URL_SCHEMA=
VITE_ANDROID_PROXY_URL_SCHEMA=

# Optional public browser features
VITE_CAPTCHA_ENABLED=false
VITE_WEB_PUSH_ENABLE=false
VITE_VAPID_PUBLIC_KEY=
